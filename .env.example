# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Production or local URL
APP_URL="https://app.drunall.com/taskflow"

# GOOGLE_CLIENT_ID: Generated from Google Cloud Console (https://console.cloud.google.com/apis/credentials)
# Create OAuth 2.0 Client ID -> Web Application
# Authorized Origins: http://localhost:3000, http://127.0.0.1:3000, https://app.drunall.com
# Authorized Redirect URIs: http://localhost:3000, https://app.drunall.com/taskflow
VITE_GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
